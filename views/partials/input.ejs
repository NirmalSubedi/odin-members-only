<div>
  <label for="<%= locals.name %>"><%= locals.label %><% if(locals.required){%><span aria-label="required">*</span><% } %></label>
  <input
    type="<%= locals.type || 'text' %>"
    name="<%= locals.name %>"
    placeholder="<%= locals.placeholder || '' %>"
    id="<%= locals.name %>"
    aria-describedby="<%= locals.name %>_error"
    value="<%= locals.values?.[locals.name] || ''  %>"
    <%if(locals.required){%>required<% } %>
    <%if(locals?.errors?.map?.[locals.name]) {%>aria-invalid="true"<% } %>
  >
</div>
