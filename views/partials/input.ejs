<div>
  <label for="<%= locals.name %>"><%= locals.label %><% if(locals.required){%><span>*</span><% } %></label>
  <input
    type="<%= locals.type || 'text' %>"
    name="<%= locals.name %>"
    id="<%= locals.name %>"
    aria-describedby="<%= locals.name %>_error"
    <%if(locals.autofocus) { %>autofocus<% } %>
    <%if(locals.placeholder){ %>placeholder='<%= placeholder %>'<% } %>
    <%if(locals.values?.[locals.name]){ %>value='<%= values[locals.name] %>'<% } %>
    <%if(locals.required){ %>required<% } %>
    <%if(locals?.errors?.map?.[locals.name]){ %>aria-invalid="true"<% } %>
  >
</div>
