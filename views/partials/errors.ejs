<% if (locals.errors) { %>
<div class="errors" tabindex="-1" autofocus="">
  <% const errorsList = errors.array({onlyFirstError:true}) %>
  <p>(<%= errorsList.length %>) <%= locals.list_name %></p>
  <ul>
    <% errorsList.forEach(error => { %>
    <li id="<%= error.path + '_error' %>"><a href="#<%=error.path%>"><%= error.msg %></a></li>
    <% }) %>  
  </ul>
</div>
<% } %>