<% if (page.hasError) { %>
<% const errors_list = page.errors_list %>
<div class="errors" tabindex="-1" autofocus="">
  <p>(<%= errors_list.length %>) <%= locals?.get_list_name?.(errors_list) ?? `Field error${errors_list.length>1?'s':''}:` %></p>
  <ul>
    <% errors_list.forEach(error => { %>
    <li id="<%= error.path + '_error' %>"><a
        href="#<%=error.path%>"
        aria-describedby="<%= error.path + '_error_link_desc' %>"
      ><%= error.msg %></a></li>
    <span hidden id="<%= error.path + '_error_link_desc' %>">Jump to <%= error.path.split('_').join(' ') %> field</span>
    <% }) %>  
  </ul>
</div>
<% } %>