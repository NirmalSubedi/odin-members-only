<nav>
  <ul>
    <li class="home"><a href="./">Home</a></li>
    <% if (locals.user && !locals.user.is_member) { %>
    <li><a href="<%- include('fragment', {path:'./join_club'}) %>">Join club</a></li>
    <% } %>
    <% if (locals.user) { %>
    <li><a href="<%- include('fragment', {path:'./new_post'}) %>">New post</a></li>
    <% } %>
