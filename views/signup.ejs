<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/title', {title:'Sign up'}) %>
    <link rel="stylesheet" href="style.css">
  </head>
  <%- include('partials/errors_hook') %>
  <body>
    <%- include('partials/nav') %>
    <main>
      <div class="form_layout_box">
        <h1 class="form_heading">Sign up</h1>
        <%- include('partials/errors') %>
        <form action="/signup" method="post" class="form">
          <% if (!page.has_error) { %>
          <p class="form_note">Fields with (<span class="field_required_text">*</span>) are required.</p>
          <% } %>
          <%- include('partials/input', {label:'First name', name:'first_name', placeholder:'John', required: true, autofocus: !page.has_error}) %>
          <%- include('partials/input', {label:'Last name', name:'last_name', placeholder:'Doe', required: true}) %>
          <%- include('partials/input', {label:'Email', name:'username', type:'email', placeholder:'johndoe@example.com', required: true}) %>
          <%- include('partials/input', {label:'Password', name:'password', type:'password', required: true}) %>
          <%- include('partials/input', {label:'Confirm password', name:'confirm_password', type:'password', required: true}) %>
          <%- include('partials/input', {label:"For admin: What is seen in the middle of March and April that can't be seen at the beginning or end of either month?", name:'admin_secret'}) %>
          <button type="submit" class="form_submit_btn">Sign up</button>
        </form>
        <p class="redirect_message">Already have an account? <a href="./login">Log in</a></p>  
      </div>
    </main>
  </body>
</html>
