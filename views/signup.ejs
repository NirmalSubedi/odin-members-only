<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign up</title>
  </head>
  <body>
    <h1>Sign up</h1>
    <% if (locals.errors) { %>
    <div class="errors">
      <p>Field errors:</p>
      <ul>
        <% errors.array().forEach(error => { %>
        <li><%= error.msg %></li>
        <% }) %>  
      </ul>
    </div>
    <% } %>
    <form action="/signup" method="post">
      <label for="first_name">First name</label>
      <input
        type="text"
        placeholder="John"
        name="first_name"
        id="first_name"
        value="<%= locals.values.first_name ? values.first_name : ''  %>"
      >
      <label for="last_name">Last name</label>
      <input
        type="text"
        placeholder="Doe"
        name="last_name"
        id="last_name"
        value="<%= locals.values.last_name ? values.last_name : ''  %>"
      >
      <label for="username">Email</label>
      <input
        type="email"
        placeholder="john@doe.com"
        name="username"
        id="username"
        value="<%= locals.values.username ? values.username : ''  %>"
      >
      <label for="password">Password</label>
      <input
        type="password"
        name="password"
        id="password"
        value="<%= locals.values.password ? values.password : ''  %>"
      >
      <label for="confirm_password">Confirm password</label>
      <input
        type="password"
        name="confirm_password"
        id="confirm_password"
        value="<%= locals.values.confirm_password ? values.confirm_password : ''  %>"
      >
      <button type="submit">Sign up</button>
    </form>
  </body>
</html>
