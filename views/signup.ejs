<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/title', {title:'Sign up'}) %>
  </head>
  <body>
    <%- include('partials/nav') %>
    <h1>Sign up</h1>
    <%- include('partials/errors', {list_name: 'Field errors:'}) %>
    <form action="/signup" method="post">
      <%- include('partials/input', {label:'First name', name:'first_name', placeholder:'John'}) %>
      <%- include('partials/input', {label:'Last name', name:'last_name', placeholder:'Doe'}) %>
      <%- include('partials/input', {label:'Email', name:'username', type:'email', placeholder:'john@doe.com'}) %>
      <%- include('partials/input', {label:'Password', name:'password', type:'password'}) %>
      <%- include('partials/input', {label:'Confirm password', name:'confirm_password', type:'password'}) %>
      <button type="submit">Sign up</button>
    </form>
  </body>
</html>
