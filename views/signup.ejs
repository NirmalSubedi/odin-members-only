<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/title', {title:'Sign up'}) %>
  </head>
  <body>
    <%- include('partials/nav') %>
    <h1>Sign up</h1>
    <%- include('partials/errors') %>
    <form action="/signup" method="post">
      <p>Fields with (*) are required.</p>
      <%- include('partials/input', {label:'First name', name:'first_name', placeholder:'John', required: true}) %>
      <%- include('partials/input', {label:'Last name', name:'last_name', placeholder:'Doe', required: true}) %>
      <%- include('partials/input', {label:'Email', name:'username', type:'email', placeholder:'johndoe@example.com', required: true}) %>
      <%- include('partials/input', {label:'Password', name:'password', type:'password', required: true}) %>
      <%- include('partials/input', {label:'Confirm password', name:'confirm_password', type:'password', required: true}) %>
      <button type="submit">Sign up</button>
    </form>
  </body>
</html>
