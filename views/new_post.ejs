<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/title', {title: 'New post'}) %>
    <link rel="stylesheet" href="style.css">
  </head>
  <%- include('partials/errors_hook') %>
  <body>
    <%- include('partials/nav') %>
    <main>
      <div class="form_layout_box">
        <h1 class="form_heading">New post</h1>
        <%- include('partials/errors') %>
        <form action="/new_post" method="post" class="form">
          <% if (!page.has_error) { %>
            <p class="form_note">Fields with (<span class="field_required_text">*</span>) are required.</p>
          <% } %>
          <%- include('partials/input', {label:'Title', name:'title', placeholder:'What would like to title your post?', required: true, autofocus:!page.has_error}) %>
          <div class="form_field">
            <label for="body" class="form_label">Body<span class="field_required_text">*</span></label>
            <textarea name="body" rows="10" class="form_input" id="body" placeholder="What is on your mind?" required <%if(locals?.errors?.map?.['body']) {%>aria-describedby="body_error" aria-invalid="true"<% } %>><%if(locals.values?.['body']){%><%= values['body'] %><% } %></textarea>
          </div>
          <button type="submit" class="form_submit_btn">Post</button>
        </form>    
      </div>
    </main>
  </body>
</html>
