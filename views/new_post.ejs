<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/title', {title: 'New post'}) %>
  </head>
  <body>
    <%- include('partials/nav') %>
    <main>
      <h1>New post</h1>
      <%- include('partials/errors') %>
      <form action="/new_post" method="post">
        <% if (!page.has_error) { %>
          <p>Fields with (*) are required.</p>
        <% } %>
        <%- include('partials/input', {label:'Title', name:'title', placeholder:'What would like to title your post?', required: true, autofocus:!page.has_error}) %>
        <div>
          <label for="body">Body <%= page.has_error ? '(required)' : '*' %></label>
          <textarea name="body" id="body" placeholder="What is on your mind?" required <%if(locals?.errors?.map?.['body']) {%>aria-describedby="body_error" aria-invalid="true"<% } %>><%if(locals.values?.['body']){%><%= values['body'] %><% } %></textarea>
        </div>
        <button type="submit">Post</button>
      </form>
    </main>
  </body>
</html>
