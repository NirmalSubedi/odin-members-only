<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/title') %>
    <link rel="stylesheet" href="style.css">
  </head>
  <body>
    <%- include('partials/nav') %>
    <main>
      <div class="welcome_message_box">
        <h1 class="welcome_message_heading">Welcome to the homepage<%= locals.user?` ${user.first_name} ${user.last_name} (${user.username})`: '' %>!</h1>
      
        <% if (locals.user?.is_new_member) { %>
        <dialog open closedby="any" class="dialog">
          <form method="dialog">
            <p aria-live="polite" class="dialog_message">Congratulation on joining the club. Get acquainted with your fellow club members by reading their posts or by creating your own posts to share.</p>
            <button type="submit" autofocus class="dialog_btn">Ok</button>
          </form>
        </dialog>
        <% } %>
      
        <% if (locals.user) { %>
        <p class="welcome_description">Have something in mind that you would like to share? Then, feel free to share it with a <a href="./new_post">new post.</a></p>
        <% } else { %>
        <p class="welcome_description"><a href="./login">Log in</a> to create a new post if you already have an account. Otherwise, feel free to <a href="./signup">sign up</a> for an account.</p>
        <% } %>
      </div>
      <div class="home_layout_box">
        <% if (locals.posts.length) { %>
        <h2 class="post_intro_head"><span class="post_counter"><%= posts.length %></span> Post<%=posts.length>1?'s':''%>:</h2>
        <div class="posts">
          <% posts.forEach(post => { %>
          <article class="post">
            <h3 class="post_title"><%= post.title %></h3>
            <p class="post_body"><%= post.body %></p>
            <% if (locals.user?.is_member || locals.user?.username === post.username) { %>
            <div class="post_metadata">
              <address>Authored by: <%= post.first_name %> <%= post.last_name %> (<a href="mailto:<%= post.username %>"><%= post.username %></a>)</address>
              <p class="post_time">Posted at <time datetime="<%= post.created_at.toISOString() %>"><%= post.created_at.toUTCString() %></time></p>
            </div>
            <% } else if (locals.user) { %>
            <p class="club_recruitment_message"><a href="./join_club">Join the club</a> to see the author's name and post time.</p>
            <% } %>
            <% if (locals.user?.is_admin) { %>
            <form action="/delete_post" method="post">
              <input
                type="hidden"
                value="<%= post.post_id %>"
                name="post_id"
                aria-hidden="true"
              >
              <button
                type="submit"
                onclick="return confirm('Are you sure you want to delete this post?')"
                class="form_submit_btn post_delete_btn"
              >Delete post</button>
            </form>
            <% } %>
          </article>
          <% }) %>
        </div>
        <% } else { %>
        <p>No posts have been created.</p>
        <% } %>
      </div>
    </main>
  </body>
</html>
