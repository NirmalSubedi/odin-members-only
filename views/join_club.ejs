<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/title', {title:'Join club'}) %>
  </head>
  <body>
    <%- include('partials/nav') %>
    <h1>Join club</h1>
    <%- include('partials/errors', {list_name: 'Errors:'}) %>
    <form action="/join_club" method="post">
      <label for="club_secret">What do you call a funny mountain???</label>
      <input
        type="club_secret"
        placeholder="Enter your answer..."
        name="club_secret"
        id="club_secret"
        aria-describedby="club_secret_error"
        value="<%= locals.values?.club_secret || '' %>"
      >
      <button type="submit">Guess</button>
    </form>
  </body>
</html>
