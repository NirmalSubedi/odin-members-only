<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/title', {title:'Join club'}) %>
    <link rel="stylesheet" href="style.css">
  </head>
  <%- include('partials/errors_hook') %>
  <body>
    <%- include('partials/nav') %>
    <main>
      <div class="form_layout_box">
        <h1 class="form_heading">Join club</h1>
        <%- include('partials/errors', {get_list_name: (errors)=> `Error${errors.length>1?'s':''}:`}) %>
        <form action="/join_club" method="post" class="form">
          <% if (!page.has_error) { %>
          <p class="form_note">Field with (<span class="field_required_text">*</span>) is required.</p>
          <% } %>
          <%- include('partials/input', {label:'What do you call a funny mountain?', name:'club_secret', placeholder:'Enter you guess here...', required:true, autofocus:!page.has_error }) %>
          <button type="submit" class="form_submit_btn">Guess</button>
        </form>
      </div>
    </main>
  </body>
</html>
