<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/title', {title:'Join club'}) %>
  </head>
  <body>
    <%- include('partials/nav') %>
    <h1>Join club</h1>
    <%- include('partials/errors', {get_list_name: (errors)=> errors.length > 1 ? 'Errors:' : 'Error:'}) %>
    <form action="/join_club" method="post">
      <p>Field with (*) is required.</p>
      <%- include('partials/input', {label:'What do you call a funny mountain???', name:'club_secret', placeholder:'Enter you guess...', required:true }) %>
      <button type="submit">Guess</button>
    </form>
  </body>
</html>
