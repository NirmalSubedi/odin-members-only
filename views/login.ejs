<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/title'), {title:'Log in'} %>
  </head>
  <body>
    <%- include('partials/nav') %>
    <h1>Log in</h1>
    <%- include('partials/errors', {list_name: 'Field errors:'}) %>
    <form action="/login" method="post">
      <%- include('partials/input', {label:'Email', name:'username', type:'email', placeholder:'john@doe.com'}) %>
      <%- include('partials/input', {label:'Password', name:'password', type:'password'}) %>
      <button type="submit">Log in</button>
    </form>
  </body>
</html>
