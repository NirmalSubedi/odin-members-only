<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/title', {title:'Log in'})%>
  </head>
  <body>
    <%- include('partials/nav') %>
    <h1>Log in</h1>
    <%- include('partials/errors') %>
    <form action="/login" method="post">
      <p>Fields with (*) are required.</p>
      <%- include('partials/input', {label:'Email', name:'username', type:'email', placeholder:'johndoe@example.com', required:true }) %>
      <%- include('partials/input', {label:'Password', name:'password', type:'password',required:true }) %>
      <div>
        <label for="is_admin">Are you an admin?</label>
        <input type="checkbox" name="is_admin" id="is_admin">
      </div>
      <button type="submit">Log in</button>
    </form>
  </body>
</html>
