<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/title', {title:'Log in'})%>
  </head>
  <%- include('partials/errors_hook') %>
  <body>
    <%- include('partials/nav') %>
    <h1>Log in</h1>
    <% if (locals.session?.is_auth_fail) { %>
      <p aria-live="assertive">You first must login to access that resource.</p>
    <% } %>
    <% if(locals.session?.messages?.length>0) {%>
      <% const [path, err_msg] = locals.session.messages.at(-1).split(': ') %>
      <%- include('partials/errors_hook', {errors: { mapped: () => ({[path]:err_msg}), array: () => [{path, msg:err_msg}] }}) %>
    <% } %>

    <%- include('partials/errors') %>
    <form action="/login" method="post">
      <% if (!page.has_error) { %>
        <p>Fields with (*) are required.</p>
      <% } %>
      <%- include('partials/input', {label:'Email', name:'username', type:'email', placeholder:'johndoe@example.com', required:true, autofocus:!page.has_error }) %>
      <%- include('partials/input', {label:'Password', name:'password', type:'password',required:true }) %>
      <button type="submit">Log in</button>
    </form>
    <p>Don't have an account? <a href="./signup">Sign up</a> for an account.</p>
  </body>
</html>
